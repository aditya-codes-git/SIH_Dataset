# ==============================================================================
# RetinoScan AI — Backend API Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your environment.
# DO NOT commit production credentials or connection strings with passwords to Git.

# Local port for Express HTTP server
PORT=5000

# Environment mode: development | production | test
NODE_ENV=development

# MongoDB Connection URI
# Local MongoDB Community Server:
MONGODB_URI=mongodb://127.0.0.1:27017/diabetic_retinopathy
# MongoDB Atlas Cloud Cluster template:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/diabetic_retinopathy?retryWrites=true&w=majority

# MATLAB executable command or absolute binary path
# If 'matlab' is on system PATH, use 'matlab'.
# Otherwise specify full path, e.g. "C:\Program Files\MATLAB\R2026a\bin\matlab.exe"
MATLAB_CMD=matlab

# Comma-separated list of allowed CORS origins for web clients
# Default local origins (http://localhost:5173, http://127.0.0.1:5173) are always enabled
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
