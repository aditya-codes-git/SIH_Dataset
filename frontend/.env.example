# ==============================================================================
# RetinoScan AI — Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your environment.

# API Base URL for backend Express service
# Default for Single-Origin & Cloudflare Quick Tunnel (Vite proxies /api -> http://localhost:5000):
VITE_API_BASE_URL=/api

# For direct cross-origin access without Vite proxy (legacy standalone):
# VITE_API_BASE_URL=http://localhost:5000/api
